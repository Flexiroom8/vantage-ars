# Copy to your host's environment settings (Vercel, Docker .env). Never commit real values.

# --- Database ---------------------------------------------------------------
# Neon / any Postgres. Migrations run on `npm run build` when this is set.
DATABASE_URL=
# Without DATABASE_URL the app uses embedded PGLite. Set a directory to keep
# data on disk (Docker volume); unset = in-memory, lost on restart.
PGLITE_DATA_DIR=

# --- Sign-in (founder office) -----------------------------------------------
# Public URL of the site, e.g. https://vantage-ars.co.za
BETTER_AUTH_URL=
# Long random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# One-time code for creating the founder account at /login. Min 16 chars.
# Remove it after the account exists; sign-up is closed once a founder exists.
FOUNDER_SETUP_TOKEN=
# The only email allowed into the office. Default: juanlouw.greyling@gmail.com
FOUNDER_EMAIL=
# Grok OAuth button. Leave off unless you have GROK_AUTH_CLIENT_ID/SECRET.
GROK_OAUTH=off

# --- AI staff: Cloudflare Workers AI (preferred) or xAI ----------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
XAI_API_KEY=
# AI_PROVIDER=xai

# --- Email (Gmail app password; rotate if it was ever shared) ---------------
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# --- Bank details on the public site and on quotes (first four required) ----
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_BRANCH_CODE=
PAYMENT_BENEFICIARY=
PAYMENT_SWIFT=

# --- Daily draft-only front-desk run. Needs both. Never emails customers. ---
AUTO_DRAFTS=off
CRON_SECRET=
