# Fires the autonomy tick every ten minutes. Persistent=true catches up a tick
# missed while the machine was off, so the office returns to cadence on boot.
[Unit]
Description=Tick the Vantage-ARS office every ten minutes

[Timer]
OnCalendar=*:0/10
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
