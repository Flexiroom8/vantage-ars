# One-shot autonomy tick, driven by vantage-ars-tick.timer.
#
# Install:
#   sudo cp deploy/systemd/vantage-ars-tick.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vantage-ars-tick.timer
#
# Reads CRON_SECRET from the same .env as the app. Exits non-zero on anything
# other than HTTP 200, so a failing tick is visible in the journal and in
# `systemctl list-timers`.
[Unit]
Description=Vantage-ARS autonomy tick (calls /api/cron/floor)
After=vantage-ars.service
Requires=vantage-ars.service

[Service]
Type=oneshot
EnvironmentFile=/opt/vantage-ars/.env
ExecStart=/bin/sh -c 'code=$(curl -sS --max-time 300 -o /dev/null -w "%%{http_code}" -H "Authorization: Bearer $CRON_SECRET" "http://127.0.0.1:3000/api/cron/floor?ts=$(date +%%s)") && echo "vantage-ars tick: HTTP $code" && [ "$code" = 200 ]'
