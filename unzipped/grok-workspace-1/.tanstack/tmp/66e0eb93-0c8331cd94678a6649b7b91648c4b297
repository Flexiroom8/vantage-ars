import { createFileRoute, getRouteApi } from "@tanstack/react-router";
import { DispatchPanel } from "@/components/office/dispatch-panel";
import { PageHeader } from "@/components/office/page-header";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { formatDateTime } from "@/lib/office/money";

export const Route = createFileRoute("/office/floor")({
  component: FloorPage,
});

const officeRoute = getRouteApi("/_office");

function FloorPage() {
  const snapshot = officeRoute.useLoaderData();

  return (
    <div className="enter-up mx-auto max-w-6xl">
      <PageHeader
        kicker="Non-human identities"
        title="Eight desks. One constitution."
        description="Each agent holds a SPIFFE identity, a role envelope, and a hard stop at the founder gates."
      />
      <div className="grid gap-4 lg:grid-cols-2">
        {snapshot.agents.map((agent) => (
          <Card key={agent.id}>
            <div className="flex items-start justify-between gap-3">
              <div>
                <p className="font-mono text-[11px] tracking-[0.18em] text-muted">{agent.callsign}</p>
                <h2 className="mt-1 font-serif text-2xl">{agent.title}</h2>
                <p className="text-xs text-muted">{agent.department}</p>
              </div>
              <Badge variant={agent.status === "halted" ? "danger" : agent.status === "blocked" ? "warn" : "ok"}>
                {agent.status}
              </Badge>
            </div>
            <p className="mt-3 text-sm text-muted">{agent.summary}</p>
            <p className="mt-3 truncate font-mono text-[11px] text-subtle">{agent.spiffeId}</p>
            <div className="mt-4 flex flex-wrap gap-1.5">
              {agent.bindings.map((b) => (
                <Badge key={b}>{b}</Badge>
              ))}
            </div>
            <dl className="mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <dt className="text-xs uppercase tracking-[0.14em] text-muted">Decisions</dt>
                <dd className="font-mono tabular-nums">{agent.decisionsCount}</dd>
              </div>
              <div>
                <dt className="text-xs uppercase tracking-[0.14em] text-muted">Escalations</dt>
                <dd className="font-mono tabular-nums">{agent.escalationsCount}</dd>
              </div>
              <div className="col-span-2">
                <dt className="text-xs uppercase tracking-[0.14em] text-muted">Now</dt>
                <dd>{agent.currentTask ?? "Idle"}</dd>
              </div>
              <div className="col-span-2">
                <dt className="text-xs uppercase tracking-[0.14em] text-muted">Heartbeat</dt>
                <dd className="text-muted">
                  {agent.lastHeartbeat ? formatDateTime(agent.lastHeartbeat) : "Awaiting first act"}
                </dd>
              </div>
            </dl>
          </Card>
        ))}
      </div>
      <div className="mt-8">
        <DispatchPanel defaultAgent="vantage" />
      </div>
    </div>
  );
}
