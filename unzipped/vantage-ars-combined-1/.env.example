# Copy to your host's environment settings. Never commit real values.

# Database (unset = local PGLite preview)
DATABASE_URL=

# AI staff: Cloudflare Workers AI (preferred) or xAI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
XAI_API_KEY=
# AI_PROVIDER=xai

# Founder and customer email (Gmail app password, rotate if it was ever shared)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Bank details shown on the public site and on quotes (all four required; SWIFT optional)
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_BRANCH_CODE=
PAYMENT_BENEFICIARY=
PAYMENT_SWIFT=

# Daily draft-only run of the front desk. Needs both. Never emails customers.
AUTO_DRAFTS=off
CRON_SECRET=
